# Base URL of the FastAPI backend the app uploads QR images to.
# Copy this file to `.env` and set the value for your setup.
#
# IMPORTANT: on a phone, `localhost` means the phone itself — it can't reach
# your dev machine. Use one of:
#   - Physical device (same Wi‑Fi): your dev machine's LAN IP, e.g.
#       EXPO_PUBLIC_API_URL=http://192.168.1.5:8000
#   - Android emulator: the host loopback alias
#       EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
#   - iOS simulator: localhost works
#       EXPO_PUBLIC_API_URL=http://localhost:8000
#
# The backend must bind 0.0.0.0 (not 127.0.0.1) to be reachable from a device:
#   py -3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
